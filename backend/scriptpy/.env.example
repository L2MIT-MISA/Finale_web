# Copier vers .env (chmod 600). Ne jamais commiter le fichier .env.

# --- Base et API ---
DATABASE_URL=
PORT=
HOTE_API=
CORS_ORIGINS=

# --- Agent IA (LangChain) : gemini | groq | cerebras | openrouter | mistral ---
# Chaîne essayée dans l'ordre ; un fournisseur sans clé est ignoré
AGENT_CHAINE=
GEMINI_API_CLE=
GEMINI_MODELES=
GROQ_API_CLE=
GROQ_MODELES=
CEREBRAS_API_CLE=
CEREBRAS_MODELES=
OPENROUTER_API_CLE=
OPENROUTER_MODELES=
MISTRAL_API_CLE=
MISTRAL_MODELES=
# Ancienne forme (toujours acceptée) : un principal et un secours
AGENT_FOURNISSEUR=
AGENT_API_CLE=
MODELE=
# Secours essayé si le principal est limité (429), hors quota ou en panne
AGENT_SECOURS_FOURNISSEUR=
AGENT_SECOURS_CLE=
AGENT_SECOURS_MODELE=
# Plafonds par fournisseur (protection du quota gratuit)
AGENT_APPELS_PAR_MINUTE=
AGENT_APPELS_PAR_JOUR=
AGENT_APPELS_SIMULTANES=

# --- Vecteurs (RAG) : off | gemini ---
VECTEURS_FOURNISSEUR=
MODELE_EMBEDDING=
INDEXATION_AUTO=

# --- Recherche web (facultatif) ---
FOURNISSEURS_RECHERCHE=
TAVILY_API_CLE=
SEARXNG_URL=
GOOGLE_API_KEY=
GOOGLE_CX=
BRAVE_API_KEY=

# --- Images (facultatif) ---
IMAGES_PAR_LIEU=
MAPILLARY_JETON=
GOOGLE_PLACES_CLE=
