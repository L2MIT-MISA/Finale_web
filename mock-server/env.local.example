# À copier dans la RACINE du projet sous le nom ".env.local" (fichier ignoré par git).
# Redirige le front vers le faux serveur (IA simulée + pylônes).
VITE_AI_API_URL=http://127.0.0.1:8000
VITE_SEARCH_API_URL=http://127.0.0.1:8000

# Auth uniquement (SiteHeader / page Connexion) : non simulée par le mock, mais le client doit pouvoir s'initialiser.
VITE_SUPABASE_URL=http://127.0.0.1:8000
VITE_SUPABASE_PUBLISHABLE_KEY=fake-key-for-mock

# La clé Google Maps reste nécessaire pour afficher la carte (dans ce fichier ou dans ton .env) :
# VITE_GOOGLE_MAPS_API_KEY=ta_cle_ici
